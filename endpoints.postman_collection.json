				{
					"name": "/login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"if (jsonData && jsonData.access_token) {\r",
									"    pm.environment.set(\"auth_token\", jsonData.access_token);\r",
									"    console.log(\"Access Token Set: \" + pm.environment.get(\"auth_token\"));\r",
									"} else {\r",
									"    console.error(\"Error: The access_token was not found in the response.\");\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
